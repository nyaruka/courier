[
    {
        "label": "Plain Send",
        "msg": {
            "text": "Simple Message",
            "urn": "tel:+250788383383"
        },
        "http_mocks": {
            "http://example.com/send*": [
                {
                    "status": 200,
                    "body": "0: Accepted for delivery"
                }
            ]
        },
        "requests": [
            {
                "method": "GET",
                "url": "http://example.com/send?to=%2B250788383383&text=Simple+Message&from=2020",
                "headers": {
                    "Content-Type": "application/x-www-form-urlencoded"
                }
            }
        ],
        "log_errors": []
    },
