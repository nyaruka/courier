            "text": "Simple Message",
            "urn": "instagram:12345",
            "origin": "chat"
        },
        "http_mocks": {
            "https://graph.facebook.com/v25.0/me/messages*": [
                {
                    "status": 200,
                    "body": {
                        "message_id": "mid.133"
                    }
                }
            ]
        },
        "requests": [
            {
                "method": "POST",
                "url": "https://graph.facebook.com/v25.0/me/messages?access_token=a123",
                "headers": {
                    "Accept": "application/json",
                    "Content-Type": "application/json"
                },
                "body": {
                    "messaging_type": "MESSAGE_TAG",
                    "tag": "HUMAN_AGENT",
                    "recipient": {
                        "id": "12345"
                    },
                    "message": {
                        "text": "Simple Message"
                    }
                }
            }
        ],
        "external_ids": [
            "mid.133"
        ],
        "log_errors": []
