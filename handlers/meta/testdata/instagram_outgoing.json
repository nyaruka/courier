                },
                "body": {
                    "messaging_type": "UPDATE",
                    "recipient": {
                        "id": "12345"
                    },
                    "message": {
                        "text": "Are you happy?",
                        "quick_replies": [
                            {
                                "title": "Yes",
                                "payload": "Yes",
                                "content_type": "text"
                            },
                            {
                                "title": "No",
                                "payload": "No",
                                "content_type": "text"
                            }
                        ]
                    }
                }
            }
        ],
        "external_ids": [
            "mid.133"
        ],
        "log_errors": []
    },
