    {
        "label": "Quick replies on a broadcast message",
        "msg": {
            "text": "Are you happy?",
            "urn": "instagram:12345",
            "quick_replies": [
                {
                    "type": "text",
                    "text": "Yes"
                },
                {
                    "type": "text",
                    "text": "No"
                }
            ],
            "origin": "broadcast"
        },
        "http_mocks": {
            "https://graph.facebook.com/v25.0/me/messages*": [
                {
                    "status": 200,
                    "body": {
