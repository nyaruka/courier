    {
        "label": "Error Direct Send not enabled for account",
        "msg": {
            "text": "Your appointment is tomorrow",
            "urn": "whatsapp:250788123123",
            "outside_window": true
        },
        "http_mocks": {
            "*/12345_ID/messages": [
                {
                    "status": 400,
                    "body": {
                        "error": {
                            "message": "(#100) Invalid parameter",
                            "type": "OAuthException",
                            "code": 100,
                            "error_data": {
                                "messaging_product": "whatsapp",
                                "details": "Parameter Invalid: The 'category' value requires Direct Send, which isn't enabled for this account."
                            }
                        }
                    }
                }
            ]
        },
        "requests": [
            {
                "method": "POST",
                "url": "https://graph.facebook.com/12345_ID/messages",
                "headers": {
                    "Accept": "application/json",
                    "Authorization": "Bearer wac_admin_system_user_token",
                    "Content-Type": "application/json"
                },
                "body": {
                    "messaging_product": "whatsapp",
                    "recipient_type": "individual",
                    "to": "250788123123",
                    "type": "text",
                    "category": "utility",
                    "text": {
                        "body": "Your appointment is tomorrow",
                        "preview_url": false
                    }
                }
            }
        ],
        "error": {
            "message": "channel rejected send with reason",
            "log_error": {
                "code": "rejected_with_reason",
                "ext_code": "100",
                "message": "(#100) Invalid parameter: Parameter Invalid: The 'category' value requires Direct Send, which isn't enabled for this account."
