    {
        "label": "Throttled",
        "msg": {
            "text": "Hello",
            "urn": "slack:U0123ABCDEF"
        },
        "http_mocks": {
            "*/chat.postMessage": [
                {
                    "status": 429,
                    "body": {
                        "ok": false,
                        "error": "ratelimited"
                    }
                }
            ]
        },
        "requests": [
            {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "headers": {
                    "Authorization": "Bearer xoxb-abc123",
                    "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                    "channel": "U0123ABCDEF",
                    "text": "Hello"
                }
            }
        ],
        "error": {
            "message": "channel rate limited",
            "retryable": true,
            "log_error": {
                "code": "connection_throttled",
                "message": "Connection to server has been rate limited."
            }
        },
        "log_errors": []
    },
