[
    {
        "label": "Plain Send",
        "msg": {
            "text": "Simple Message",
            "urn": "slack:U0123ABCDEF"
        },
        "http_mocks": {
            "*/chat.postMessage": [
                {
                    "status": 200,
                    "body": {
                        "ok": true,
                        "channel": "U0123ABCDEF"
                    }
                }
            ]
        },
        "requests": [
            {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "headers": {
                    "Authorization": "Bearer xoxb-abc123",
                    "Content-Type": "application/json; charset=utf-8"
                },
                "body": {
                    "channel": "U0123ABCDEF",
                    "text": "Simple Message"
                }
            }
        ],
        "log_errors": []
    },
