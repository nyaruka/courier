    {
        "label": "Send Image",
        "msg": {
            "urn": "slack:U0123ABCDEF",
            "attachments": [
                "image/jpeg:https://foo.bar/image.png"
            ]
        },
        "http_mocks": {
            "*/files.completeUploadExternal": [
                {
                    "status": 200,
                    "body": {
                        "ok": true,
                        "files": [
                            {
                                "id": "F1L3SL4CK1D",
                                "title": "image.png"
                            }
                        ]
                    }
                }
            ],
            "*/files.getUploadURLExternal": [
                {
                    "status": 200,
                    "body": {
                        "ok": true,
                        "upload_url": "https://files.slack.com/upload/v1/ABC123",
                        "file_id": "F1L3SL4CK1D"
                    }
                }
            ],
            "*/image.png": [
                {
                    "status": 200,
                    "body": "filetype... ...file bytes... ...end"
                }
            ],
            "https://files.slack.com/upload/v1/ABC123": [
                {
                    "status": 200,
                    "body": "OK - 35"
                }
            ]
        },
        "requests": [
            {
                "method": "GET",
                "url": "https://foo.bar/image.png"
            },
            {
                "method": "POST",
                "url": "https://slack.com/api/files.getUploadURLExternal",
                "headers": {
                    "Authorization": "Bearer xoxb-abc123",
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "form": {
                    "filename": [
                        "image.png"
                    ],
                    "length": [
                        "35"
                    ]
                }
            },
            {
                "method": "POST",
                "url": "https://files.slack.com/upload/v1/ABC123",
                "headers": {
                    "Content-Type": "application/octet-stream"
                },
                "body": "filetype... ...file bytes... ...end"
            },
            {
                "method": "POST",
                "url": "https://slack.com/api/files.completeUploadExternal",
                "headers": {
                    "Authorization": "Bearer xoxb-abc123",
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                "form": {
                    "channels": [
                        "U0123ABCDEF"
                    ],
                    "files": [
                        "[{\"id\":\"F1L3SL4CK1D\",\"title\":\"image.png\"}]"
                    ]
                }
            }
        ],
        "log_errors": []
    },
